{
  "url": "http://localhost:3457/login",
  "waitText": "Acessar sistema",
  "assertVisible": ["main"],
  "screenshots": ["desktop"],
  "steps": [
    { "action": "fill", "args": ["#login-email", "__E2E_ADMIN_EMAIL__"] },
    { "action": "fill", "args": ["#login-password", "__E2E_ROLE_PASSWORD__"] },
    { "action": "click", "args": ["button[type=submit]"] },
    { "action": "wait", "args": ["--url", "*painel*"] },
    { "action": "wait", "args": ["--fn", "document.body.innerText.includes('Carteira operacional')"] },
    { "action": "fill", "args": ["input[aria-label='Buscar loja, cliente ou responsável']", "gocars"] },
    { "action": "wait", "args": ["--fn", "location.search.includes('carteiraBusca=gocars')"] },
    { "action": "open", "args": ["http://localhost:3457/painel?carteiraSituacao=com_bloqueios&carteiraBusca=norte"] },
    { "action": "wait", "args": ["--fn", "document.body.innerText.includes('Carteira operacional')"] },
    { "action": "wait", "args": ["--fn", "document.querySelector(\"select[value], select\") && [...document.querySelectorAll('select')].some(s=>s.value==='com_bloqueios')"] },
    { "action": "wait", "args": ["--fn", "document.querySelector(\"input[aria-label='Buscar loja, cliente ou responsável']\").value==='norte'"] }
  ]
}
