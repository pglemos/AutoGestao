{
  "url": "http://localhost:3457/login",
  "waitText": "Acessar sistema",
  "assertVisible": [
    "main"
  ],
  "assertText": [
    "Carteira operacional",
    "Fila de prioridades",
    "Governança da carteira",
    "Exibindo"
  ],
  "screenshots": [
    "desktop",
    "mobile"
  ],
  "steps": [
    {
      "action": "fill",
      "args": [
        "#login-email",
        "__E2E_ADMIN_EMAIL__"
      ]
    },
    {
      "action": "fill",
      "args": [
        "#login-password",
        "__E2E_ROLE_PASSWORD__"
      ]
    },
    {
      "action": "click",
      "args": [
        "button[type=submit]"
      ]
    },
    {
      "action": "wait",
      "args": [
        "--url",
        "*painel*"
      ]
    },
    {
      "action": "wait",
      "args": [
        "--fn",
        "document.body.innerText.includes('Carteira operacional')"
      ]
    }
  ],
  "measure": [
    "#carteira-operacional table",
    "#carteira-operacional thead tr",
    "#carteira-operacional tbody tr:first-child",
    "#carteira-operacional tbody tr:first-child td:last-child",
    "[data-mx-page-canvas]"
  ]
}