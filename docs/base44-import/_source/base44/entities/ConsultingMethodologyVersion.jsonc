{
  "name": "ConsultingMethodologyVersion",
  "type": "object",
  "properties": {
    "consulting_product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_version_number": {
      "type": "string"
    },
    "methodology_version_number": {
      "type": "string",
      "default": "1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "RASCUNHO",
        "EM_REVISAO",
        "PUBLICADO",
        "SUBSTITUIDO",
        "ARQUIVADO"
      ],
      "default": "RASCUNHO"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_until": {
      "type": "string",
      "format": "date"
    },
    "change_summary": {
      "type": "string"
    },
    "encounters_configured": {
      "type": "number",
      "default": 0
    },
    "encounters_pending": {
      "type": "number",
      "default": 0
    },
    "videos_count": {
      "type": "number",
      "default": 0
    },
    "files_count": {
      "type": "number",
      "default": 0
    },
    "report_templates_count": {
      "type": "number",
      "default": 0
    },
    "created_by": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "published_by": {
      "type": "string"
    },
    "published_at": {
      "type": "string"
    }
  },
  "required": [
    "consulting_product_id",
    "methodology_version_number"
  ]
}