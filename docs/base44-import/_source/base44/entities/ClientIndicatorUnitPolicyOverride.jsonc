{
  "name": "ClientIndicatorUnitPolicyOverride",
  "type": "object",
  "properties": {
    "strategic_plan_cycle_id": {
      "type": "string"
    },
    "client_account_id": {
      "type": "string"
    },
    "indicator_definition_id": {
      "type": "string"
    },
    "indicator_code": {
      "type": "string"
    },
    "indicator_name": {
      "type": "string"
    },
    "default_unit_entry_mode": {
      "type": "string"
    },
    "default_unit_rollup_method": {
      "type": "string"
    },
    "unit_entry_mode_override": {
      "type": "string",
      "enum": [
        "PER_UNIT_REQUIRED",
        "PER_UNIT_OPTIONAL",
        "COMPANY_ONLY",
        "SHARED_COMPANY_VALUE"
      ]
    },
    "unit_rollup_method_override": {
      "type": "string",
      "enum": [
        "SUM",
        "RECALCULATE_FROM_BASES",
        "WEIGHTED_AVERAGE",
        "AVERAGE_VALID_VALUES",
        "LAST_VALID_VALUE",
        "SHARED_NO_SUM",
        "COMPANY_VALUE",
        "MANUAL_CONSOLIDATED"
      ]
    },
    "weight_indicator_id": {
      "type": "string"
    },
    "weight_indicator_code": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ATIVO",
        "SUBSTITUIDO",
        "ENCERRADO"
      ],
      "default": "ATIVO"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "strategic_plan_cycle_id",
    "client_account_id",
    "indicator_definition_id"
  ]
}