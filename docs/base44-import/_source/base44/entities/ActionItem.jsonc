{
  "name": "ActionItem",
  "type": "object",
  "properties": {
    "action_plan_id": {
      "type": "string"
    },
    "item_order": {
      "type": "number",
      "default": 1
    },
    "title": {
      "type": "string"
    },
    "action_description": {
      "type": "string"
    },
    "execution_instructions": {
      "type": "string"
    },
    "how_to_execute": {
      "type": "string"
    },
    "checklist": {
      "type": "string"
    },
    "completion_criteria": {
      "type": "string"
    },
    "is_required": {
      "type": "boolean",
      "default": true
    },
    "responsible": {
      "type": "string"
    },
    "responsible_id": {
      "type": "string"
    },
    "participants": {
      "type": "string"
    },
    "deadline_offset_days": {
      "type": "number",
      "default": 0
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "NAO_INICIADA",
        "EM_ANDAMENTO",
        "ATRASADA",
        "CONCLUIDA",
        "PAUSADA",
        "CANCELADA"
      ],
      "default": "NAO_INICIADA"
    },
    "weight_basis_points": {
      "type": "number",
      "default": 0
    },
    "weight_percentage_display": {
      "type": "string"
    },
    "support_material_type": {
      "type": "string",
      "enum": [
        "NONE",
        "FILE",
        "UNIVERSITY_LESSON"
      ],
      "default": "NONE"
    },
    "file_asset_id": {
      "type": "string"
    },
    "file_asset_name": {
      "type": "string"
    },
    "learning_content_id": {
      "type": "string"
    },
    "learning_content_version_id": {
      "type": "string"
    },
    "learning_content_name": {
      "type": "string"
    },
    "evidence_required": {
      "type": "boolean",
      "default": false
    },
    "evidence_type": {
      "type": "string"
    },
    "evidence_url": {
      "type": "string"
    },
    "evidence_notes": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "source_template_item_id": {
      "type": "string"
    }
  },
  "required": [
    "action_plan_id",
    "title"
  ]
}