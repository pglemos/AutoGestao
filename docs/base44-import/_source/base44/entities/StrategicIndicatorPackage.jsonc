{
  "name": "StrategicIndicatorPackage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "SUPERSEDED",
        "ARCHIVED"
      ],
      "default": "DRAFT"
    },
    "current_published_version_id": {
      "type": "string"
    },
    "migration_origin": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}