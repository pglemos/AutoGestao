{
  "name": "FunctionalTestCase",
  "type": "object",
  "properties": {
    "test_code": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "screen": {
      "type": "string"
    },
    "precondition": {
      "type": "string"
    },
    "steps": {
      "type": "string"
    },
    "expected_result": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "NAO_TESTADO",
        "APROVADO",
        "REPROVADO",
        "BLOQUEADO"
      ],
      "default": "NAO_TESTADO"
    },
    "tested_by": {
      "type": "string"
    },
    "tested_at": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "test_code",
    "module",
    "screen",
    "expected_result"
  ]
}