{
  "name": "ConsultantProductQualification",
  "type": "object",
  "properties": {
    "consultant_profile_id": {
      "type": "string"
    },
    "consultant_name": {
      "type": "string"
    },
    "consulting_product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_program": {
      "type": "string"
    },
    "product_version": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "qualification_level": {
      "type": "string",
      "enum": [
        "EM_FORMACAO",
        "HABILITADO_APOIO",
        "HABILITADO_RESPONSAVEL",
        "HABILITADO_VALIDADOR"
      ],
      "default": "HABILITADO_RESPONSAVEL"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "granted_by": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ATIVO",
        "SUSPENSO",
        "EXPIRADO"
      ],
      "default": "ATIVO"
    }
  },
  "required": [
    "consultant_profile_id",
    "consulting_product_id"
  ]
}