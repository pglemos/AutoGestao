{
  "name": "EncounterLesson",
  "type": "object",
  "properties": {
    "client_account_id": {
      "type": "string"
    },
    "journey_encounter_instance_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "lesson_order": {
      "type": "number",
      "default": 1
    },
    "is_required": {
      "type": "boolean",
      "default": true
    },
    "video_source": {
      "type": "string",
      "enum": [
        "UPLOAD",
        "LINK_EXTERNO",
        "YOUTUBE",
        "VIMEO",
        "OUTRO"
      ],
      "default": "LINK_EXTERNO"
    },
    "video_url": {
      "type": "string"
    },
    "video_file_asset_id": {
      "type": "string"
    },
    "thumbnail_file_asset_id": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "RASCUNHO",
        "EM_REVISAO",
        "PUBLICADO",
        "ARQUIVADO"
      ],
      "default": "RASCUNHO"
    },
    "visibility": {
      "type": "string",
      "default": "DONO_E_EQUIPE_MX"
    },
    "published_at": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "client_account_id",
    "journey_encounter_instance_id",
    "title"
  ]
}