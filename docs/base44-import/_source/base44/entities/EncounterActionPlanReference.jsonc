{
  "name": "EncounterActionPlanReference",
  "type": "object",
  "properties": {
    "methodology_version_id": {
      "type": "string"
    },
    "encounter_template_id": {
      "type": "string"
    },
    "action_plan_template_version_id": {
      "type": "string"
    },
    "action_plan_template_name": {
      "type": "string"
    },
    "recommendation_enabled": {
      "type": "boolean",
      "default": false
    },
    "display_order": {
      "type": "number",
      "default": 1
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "ATIVO",
        "INATIVO"
      ],
      "default": "ATIVO"
    }
  },
  "required": [
    "methodology_version_id",
    "encounter_template_id",
    "action_plan_template_version_id"
  ]
}